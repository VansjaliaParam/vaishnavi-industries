# Resend API key - https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Where enquiries land. Defaults to site.email if unset.
ENQUIRY_TO=vaishnaviind17@gmail.com

# The "From" line. Until you verify a domain in Resend, leave this as-is:
# onboarding@resend.dev only delivers to your own Resend account email.
# After verifying vaishnaviindustries.com, switch to e.g.
#   ENQUIRY_FROM=Vaishnavi Industries <enquiries@vaishnaviindustries.com>
ENQUIRY_FROM=Website Enquiry <onboarding@resend.dev>
